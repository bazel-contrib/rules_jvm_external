"""Merge-friendly lock documents with explicit inputs and local record hashes."""

load("//private/lib:coordinates.bzl", "to_key", "unpack_coordinates")
load(":lock_file_records.bzl", "compute_hashes", "normalise_v3", "parse_external_form", "records_by_identity", "records_from_v3", "stored_hashes")
load(":lock_file_requests.bzl", "attach_requests", "read_inputs")
load(":v3_lock_file.bzl", "v3_lock_file")

_REQUIRED_TYPES = {"artifacts": "list", "boms": "list", "dependencies": "dict", "repositories": "dict", "settings": "dict", "unresolved_requests": "list"}

def _is_valid(contents):
    return contents.get("version") == "4" and all([type(contents.get(key)) == value for key, value in _REQUIRED_TYPES.items()])

def _get_artifacts(contents):
    artifacts = []
    for identity, row in records_by_identity(contents).items():
        parsed = parse_external_form(row[0])
        root = parsed.group + ":" + parsed.artifact
        if parsed.packaging:
            root += ":" + parsed.packaging
        legacy = dict(contents)
        legacy["artifacts"] = {root: {"version": parsed.version, "shasums": {parsed.classifier or "jar": row[1]}}}
        artifact = v3_lock_file.get_artifacts(legacy)[0]
        if parsed.classifier and unpack_coordinates(artifact["coordinates"]).classifier != parsed.classifier:
            # Legacy consumers otherwise mistake named versions for packaging.
            artifact["coordinates"] = "%s:%s:jar:%s:%s" % (parsed.group, parsed.artifact, parsed.classifier, parsed.version)
        artifacts.append(artifact)
    return artifacts

def _difference(old, new):
    if "settings" in old or "settings" in new:
        return "changed %s" % ", ".join([key for key in ["artifacts", "boms", "settings"] if old.get(key) != new.get(key)])
    return v3_lock_file.print_friendly_hash_difference(old, new)

def _render_value(key, value):
    if key == "artifacts":
        # Unchanged separators let Git merge updates to neighbouring records.
        return "[\n" + ",\n\n".join(["    " + json.encode(row) for row in value]) + "\n  ]" if value else "[]"
    if key == "repositories" and value:
        # Repository order remains the download preference, independently of integrity.
        entries = ["    %s: %s" % (json.encode(repo), json.encode_indent(artifacts, prefix = "    ", indent = "  ")) for repo, artifacts in value.items()]
        return "{\n" + ",\n".join(entries) + "\n  }"
    return json.encode_indent(value, prefix = "  ", indent = "  ")

def _render(contents, inputs, include_files = False):
    contents = normalise_v3(contents)
    converted = {key: value for key, value in contents.items() if key not in ["__INPUT_ARTIFACTS_HASH", "__RESOLVED_ARTIFACTS_HASH", "artifacts", "files", "version"]}
    converted["__AUTOGENERATED_FILE_DO_NOT_MODIFY_THIS_FILE_MANUALLY"] = "THERE_IS_NO_DATA_ONLY_ZUUL"
    converted["artifacts"] = records_from_v3(contents)
    converted["version"] = "4"
    if include_files and "files" in contents:
        converted["files"] = contents["files"]
    if converted.get("m2local"):
        remote = {identity: True for identities in converted["repositories"].values() for identity in identities}
        converted["m2local_artifacts"] = sorted([to_key(parse_external_form(row[0])) for row in converted["artifacts"] if to_key(parse_external_form(row[0])) not in remote and to_key(parse_external_form(row[0])) not in converted.get("skipped", [])])
    attach_requests(converted, inputs)
    hashes = compute_hashes(converted)
    if None in hashes.values():
        fail("Cannot pin lock file with missing dependencies: %s" % ", ".join([identity for identity, value in hashes.items() if value == None]))
    for row in converted["artifacts"]:
        row[2] = hashes[to_key(parse_external_form(row[0]))]
    entries = ["  %s: %s" % (json.encode(key), _render_value(key, converted[key])) for key in sorted(converted)]
    return "{\n" + ",\n".join(entries) + "\n}\n"

v4_lock_file = struct(
    is_valid_lock_file = _is_valid,
    get_inputs = read_inputs,
    get_lock_file_hash = stored_hashes,
    compute_lock_file_hash = compute_hashes,
    print_friendly_hash_difference = _difference,
    get_artifacts = _get_artifacts,
    get_netrc_entries = v3_lock_file.get_netrc_entries,
    has_m2local = v3_lock_file.has_m2local,
    render_lock_file = _render,
)
